{{!< default}}

<header>
    {{#tag}}
    <h1><a href="{{@site.url}}" class="title">Tag: {{name}}</a></h1>
    {{/tag}}
</header>

<ul class="posts">
    {{#foreach posts}}
        <li>
            <time datetime="{{date format="YYYY-MM-DD"}}" class="muted">{{date format="DD MMMM YYYY"}}</time>
            <a href="{{url}}">{{title}}</a>
            {{#if custom_excerpt}}<p class="muted">{{custom_excerpt}}</p>{{/if}}
        </li>
    {{else}}
        <li>Nothing posted yet.</li>
    {{/foreach}}
</ul>

{{pagination}}