{{!< default}}
{{#contentFor "meta"}}
    Bookmarks{{#if pagination.page}}{{#match pagination.page ">" 1}} (Page {{pagination.page}}){{/match}}{{/if}} - {{@site.title}}
{{/contentFor}}

<header>
    <h1><a href="{{@site.url}}" class="title">Bookmarks</a></h1>
    <p class="subtitle muted">Some of my favorite links from around the web.</p>
</header>

{{#get "posts" filter="tag:hash-bookmark" limit="all"}}
<ul class="posts">
    {{#foreach posts}}
        <li>
            <a href="{{url}}"><time datetime="{{date format="YYYY-MM-DD"}}" class="muted">{{date format="DD MMMM YYYY"}}</time></a>
            {{content}}
        </li>
    {{else}}
        <li>Nothing posted yet.</li>
    {{/foreach}}
</ul>
{{pagination}}
{{/get}}