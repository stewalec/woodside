{
    "name": "woodside",
    "description": "A minimal and contemplative theme for Ghost",
    "demo": "https://alecstewart.com",
    "version": "1.2.1",
    "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
    "engines": {
        "ghost": ">=5.0.0"
    },
    "license": "MIT",
    "scripts": {
        "zip": "mkdir -p dist && bestzip dist/$npm_package_name.zip assets/* partials/* *.hbs package.json",
        "pretest": "pnpm run zip",
        "test": "gscan ."
    },
    "author": {
        "name": "Alec Stewart",
        "email": "alec@alecstewart.com",
        "url": "https://alecstewart.com"
    },
    "gpm": {
        "type": "theme",
        "categories": [
            "Minimal",
            "Contemplative"
        ]
    },
    "keywords": [
        "ghost",
        "theme",
        "ghost-theme"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/stewalec/woodside.git"
    },
    "bugs": "https://github.com/stewalec/woodside/issues",
    "contributors": "https://github.com/stewalec/woodside/graphs/contributors",
    "devDependencies": {
        "bestzip": "3.0.2",
        "gscan": "6.4.2"
    },
    "config": {
        "posts_per_page": 50
    }
}
